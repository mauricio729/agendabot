# Copie para .env e preencha. Sem WHATSAPP_TOKEN o bot roda em modo console.
CLINIC_NAME=Clínica Sorriso

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=agendabot-dev
WHATSAPP_APP_SECRET=
REMINDER_TEMPLATE=lembrete_consulta

# Agenda: local (banco do próprio bot) ou google
CALENDAR_PROVIDER=local
GOOGLE_CALENDAR_ID=primary
GOOGLE_TOKEN_FILE=token.json

# Lembretes: memory (só registra no log) ou celery (envia de verdade)
REMINDERS=memory
REDIS_URL=

DB_PATH=agendabot.db
ADMIN_TOKEN=troque-esta-chave
